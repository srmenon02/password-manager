VITE_API_URL=http://localhost:8000

# Cookieless self-hosted analytics (Plausible/Umami). Both must be set or analytics
# stays disabled. Serve the script from this app's own origin (e.g. a proxied
# /js/script.js) to keep the `script-src 'self'` CSP in index.html unchanged.
VITE_ANALYTICS_SRC=
VITE_ANALYTICS_DOMAIN=
